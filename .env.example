# Copy this file to ".env" and change the values.
# The ".env" file is private: never commit it or share it.
# Restart the server after changing anything here.

# --- Admin login for /admin.html ---------------------------------------
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Article database ----------------------------------------------------
# Get a connection string from your MongoDB deployment. URL-encode any
# reserved characters in the database user's password.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/<database>?retryWrites=true&w=majority

# --- Article images ------------------------------------------------------
# Find these values in the Cloudinary Console. Keep the API secret private.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Fapshi online donations ----------------------------------------------
# Get API credentials from your Fapshi collection service. Sandbox is the
# safe default; switch to "live" only with live credentials and an activated service.
FAPSHI_API_USER=
FAPSHI_API_KEY=
FAPSHI_ENVIRONMENT=sandbox

# --- Security -------------------------------------------------------------
# A long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# How long an admin stays signed in, in hours.
SESSION_HOURS=12

# --- Server -----------------------------------------------------------------
PORT=3000
# Your public website origin, with no trailing slash, for example https://www.example.org
# Required for Fapshi's post-payment return; also used for canonical links and social previews.
SITE_URL=
# Set to true if the site is served over HTTPS behind a proxy or host (Render, Railway, Nginx, ...).
TRUST_PROXY=false
COOKIE_SECURE=false
